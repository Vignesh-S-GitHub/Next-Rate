{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextrate-scheduler",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Activate these only after installing the secret and checking the live path.
  "triggers": {
    "crons": ["45 7 * * *", "45 13 * * *", "15 8,14 * * *", "45 8,14 * * *"]
  }
}
